msgid "GNN IPinfo Settings"
msgstr "GNN IPinfo Ayarları"

msgid "GNN IPinfo"
msgstr "GNN IPinfo"

msgid "API Settings"
msgstr "API Ayarları"

msgid "API Token"
msgstr "API Token"

msgid "Debug Mode"
msgstr "Hata Ayıklama Modu"

msgid "Show"
msgstr "Göster"

msgid "Hide"
msgstr "Gizle"

#. translators: %s: link to IPinfo dashboard
msgid "Enter your IPinfo API token. You can find or generate your token on the %s."
msgstr "IPinfo API token'ınızı girin. Token'ınızı %s üzerinden bulabilir veya oluşturabilirsiniz."

msgid "IPinfo dashboard"
msgstr "IPinfo paneli"

msgid "Display diagnostic technical details to administrators on the frontend."
msgstr "Ön yüzde yöneticilere teknik teşhis detaylarını göster."

msgid "When enabled, logged-in administrators will see cache status (HIT/MISS), resolved client IP, and header source beneath the shortcode output."
msgstr "Etkinleştirildiğinde, giriş yapmış yöneticiler kısa kod çıktısının altında önbellek durumunu (HIT/MISS), çözümlenen istemci IP adresini ve başlık kaynağını görür."

msgid "API Token not found. Please enter the API Token in the settings."
msgstr "API Belirteci bulunamadı. Lütfen API Token'ı ayarlara girin."

msgid "Visitor IP address could not be determined."
msgstr "Ziyaretçi IP adresi belirlenemedi."

msgid "IP information temporarily unavailable. Please try again in a few moments."
msgstr "IP bilgileri geçici olarak kullanılamıyor. Lütfen birkaç dakika sonra tekrar deneyin."

msgid "API request failed. Please try again later."
msgstr "API isteği başarısız oldu. Lütfen daha sonra tekrar deneyin."

msgid "IP information could not be retrieved from provider."
msgstr "IP bilgileri sağlayıcıdan alınamadı."

msgid "Invalid response from IP information provider."
msgstr "IP bilgi sağlayıcısından geçersiz yanıt alındı."

msgid "Visitor IP Information"
msgstr "Ziyaretçi IP Bilgileri"

msgid "[GNN IPinfo Diagnostic — Admin Only]"
msgstr "[GNN IPinfo Teşhis — Yalnızca Yönetici]"

#. translators: 1: cache status (HIT/MISS), 2: resolved header source, 3: resolved IP address
msgid "Cache: %1$s | Source Header: %2$s | Resolved IP: %3$s"
msgstr "Önbellek: %1$s | Kaynak Başlık: %2$s | Çözümlenen IP: %3$s"

msgid "Donate"
msgstr "Bağış"

msgid "Settings"
msgstr "Ayarlar"

msgid "Check Updates"
msgstr "Güncellemeleri Kontrol Et"

msgid "A plugin that displays visitor IP information using the IPinfo.io API."
msgstr "IPinfo.io API kullanarak ziyaretçi IP bilgilerini görüntüleyen bir eklenti."

msgid "Security check failed."
msgstr "Güvenlik doğrulaması başarısız oldu."

msgid "Sorry, you are not allowed to update plugins on this site."
msgstr "Üzgünüz, bu sitede eklentileri güncelleme yetkiniz yok."
